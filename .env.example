# ---- Core ----
ANTHROPIC_API_KEY=
ADMIN_TOKEN=
POSTGRES_PASSWORD=
TV_BRIDGE_URL=http://host.docker.internal:3010

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram user ids allowed to issue commands. Leave empty to accept commands only in private chats
# with the bot (there chat id == user id). Required if an allowed chat above is a group — otherwise
# group chats are ignored, since every member of the group could control the accounts.
TELEGRAM_ALLOWED_USER_IDS=
# PIN for /closeall, /move, /unpause. Empty = those commands are disabled.
# Use 8+ characters, not a 4-digit code: the 3-tries/15-min lockout lives in memory and resets
# whenever the strategy container restarts.
TELEGRAM_PIN=

# ---- Accounts ----
# Indices MUST be contiguous from 0: AccountRegistry stops reading at the first gap, so a hole
# here silently drops every account after it.
#
# Credentials and base URL are PER ACCOUNT — there is no venue-wide default on purpose, so a
# production account can never silently inherit a demo domain. The service refuses to start if an
# account has keys but no base URL, or if two accounts share the same API key. An account with
# blank keys is fine: it stays visible in the panel, just unconnected.

TRADING_ACCOUNTS_0_ID=bingx-vst
TRADING_ACCOUNTS_0_EXCHANGE=bingx
TRADING_ACCOUNTS_0_API_KEY=
TRADING_ACCOUNTS_0_API_SECRET=
TRADING_ACCOUNTS_0_BASE_URL=https://open-api-vst.bingx.com

# 1 — Binance testnet demo (fully wired: reader + execution adapter).
TRADING_ACCOUNTS_1_ID=binance-demo
TRADING_ACCOUNTS_1_EXCHANGE=binance
TRADING_ACCOUNTS_1_API_KEY=
TRADING_ACCOUNTS_1_API_SECRET=
TRADING_ACCOUNTS_1_BASE_URL=https://testnet.binancefuture.com

TRADING_ACCOUNTS_2_ID=bybit-demo
TRADING_ACCOUNTS_2_EXCHANGE=bybit
TRADING_ACCOUNTS_2_API_KEY=
TRADING_ACCOUNTS_2_API_SECRET=
TRADING_ACCOUNTS_2_BASE_URL=https://api-demo.bybit.com

# REAL MONEY — note the production domain, not the VST one above.
TRADING_ACCOUNTS_3_ID=bingx-prod
TRADING_ACCOUNTS_3_EXCHANGE=bingx
TRADING_ACCOUNTS_3_API_KEY=
TRADING_ACCOUNTS_3_API_SECRET=
TRADING_ACCOUNTS_3_BASE_URL=https://open-api.bingx.com

# Pionex is read-only: its Futures API (Beta) exposes no TP/SL, so no execution adapter is wired
# and StopGuard skips this account instead of alerting on a check it cannot perform.
TRADING_ACCOUNTS_4_ID=pionex-demo
TRADING_ACCOUNTS_4_EXCHANGE=pionex
TRADING_ACCOUNTS_4_API_KEY=
TRADING_ACCOUNTS_4_API_SECRET=
TRADING_ACCOUNTS_4_BASE_URL=https://api.pionex.com
